root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Paradox 脚本：原版风格是 Tab 缩进，行尾不修剪（避免无意义 diff 噪音）
[*.{txt,mod,csv,shader,gfx,gui,asset}]
indent_style = tab
trim_trailing_whitespace = false

[*.{md,json,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf
charset = utf-8-bom
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.{sh,bat}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# shell 脚本：LF + 无 BOM（CRLF 会让 bash 报 $'\r': command not found）
[*.sh]
end_of_line = lf
charset = utf-8

# 批处理：必须 CRLF + 无 BOM，且只写纯 ASCII（中文会让 cmd 解析错位）
[*.bat]
end_of_line = crlf
charset = utf-8
