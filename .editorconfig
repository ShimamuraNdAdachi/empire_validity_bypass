root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Paradox 脚本：原版风格是 Tab 缩进，行尾不修剪（避免无意义 diff 噪音）
[*.{txt,mod,csv,shader,gfx,gui,asset}]
indent_style = tab
trim_trailing_whitespace = false

[*.{md,json,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf
indent_style = space
indent_size = 4
